# Copy to .env (never commit .env). All values are optional.

# Port the API + websocket server listens on.
PORT=8787

# Where the SQLite database lives. Created on first start.
DATA_DIR=./data

# The URL participants will open on their phones. Must be reachable from their
# network — "localhost" only works on the facilitator's own machine.
# In development you can use your LAN address, e.g. http://192.168.1.20:5173
# In production this is your public domain, e.g. https://workshop.example.org
PUBLIC_BASE_URL=

# Optional: comma-separated list of allowed origins for API/websocket requests.
# Defaults to allowing the PUBLIC_BASE_URL origin and localhost dev origins.
ALLOWED_ORIGINS=

# Optional: a secret that lets someone create workshops. Leave empty to allow
# anyone who can reach the site to create a workshop (fine for a LAN demo;
# set it for a public deployment).
CREATE_WORKSHOP_SECRET=

# Optional: longest a single calculation may run before it is terminated (milliseconds).
CALCULATION_TIME_LIMIT_MS=15000

# Saving copies of workshops to a private GitHub repository (the Save tab offers it).
# local (default): only from a browser on the same computer as the server.  on: any organizer.  off: never.
GITHUB_BACKUP=local
# The repository is found by this name on the signed-in account, and created as private if missing.
GITHUB_BACKUP_REPO=backchaining-models
# Optional. If unset, the GitHub command-line tool's sign-in (gh auth login) is used.
GITHUB_TOKEN=
